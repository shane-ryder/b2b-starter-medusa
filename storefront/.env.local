# Your Medusa backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server. See – https://docs.medusajs.com/usage/configurations#admin_cors-and-store_cors
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:56000
#NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Your publishable key that can be attached to sales channels. See - https://docs.medusajs.com/development/publishable-api-keys
# windows 电脑的medusa后台
 NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_9b52e05b3fbf36c1fb49f4416fa1ba82e699a83e97f5e1da834d5a7c783339d8
# windows docker 电脑的medusa后台
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_9a3e535887642d5ad1afe1d7f724f74797b022997e865402ef098ffcf1a86368

# mac docker 电脑的medusa后台
#NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_e83713b40517579152d8c0772a557c0cceb523f78785852e4fb7f835b6304173

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:57000

# Your preferred default region. When middleware cannot determine the user region from the "x-vercel-country" header, the default region will be used. ISO-2 lowercase format.
NEXT_PUBLIC_DEFAULT_REGION=us

# Your Medusa payments publishable key. You can find it in your Medusa dashbard.
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=

# Your Medusa payments external account ID. You can find it in your Medusa dashbard.
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Your Next.js revalidation secret. See – https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=supersecret
